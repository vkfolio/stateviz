{
  "name": "stateviz",
  "displayName": "StateViz",
  "description": "Preview LangGraph StateGraph flows from Python files directly beside the editor in VS Code.",
  "version": "0.0.1",
  "publisher": "vigneshkarnika",
  "license": "MIT",
  "keywords": [
    "langgraph",
    "python",
    "mermaid",
    "graph",
    "visualization",
    "workflow"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/vkfolio/stateviz"
  },
  "homepage": "https://github.com/vkfolio/stateviz#readme",
  "bugs": {
    "url": "https://github.com/vkfolio/stateviz/issues"
  },
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Visualization",
    "Other"
  ],
  "icon": "media/stateviz.png",
  "activationEvents": [
    "onLanguage:python",
    "onCommand:stateviz.openPreview",
    "onCommand:stateviz.reveal"
  ],
  "main": "./dist/extension.js",
  "files": [
    "dist/**",
    "media/**",
    "README.md",
    "LICENSE",
    "package.json"
  ],
  "contributes": {
    "commands": [
      {
        "command": "stateviz.openPreview",
        "title": "StateViz: Open Preview"
      },
      {
        "command": "stateviz.reveal",
        "title": "StateViz: Open Preview"
      },
      {
        "command": "stateviz.refresh",
        "title": "StateViz: Refresh Graph"
      }
    ],
    "configuration": {
      "title": "StateViz",
      "properties": {
        "stateviz.marker": {
          "type": "string",
          "default": "# stateviz: langgraph",
          "description": "Magic comment required before StateViz attempts to parse a Python file."
        }
      }
    }
  },
  "scripts": {
    "build": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "test": "node --test dist/test/**/*.test.js",
    "pretest": "npm run build",
    "package": "vsce package --no-dependencies"
  },
  "devDependencies": {
    "@types/node": "^22.14.1",
    "@types/vscode": "^1.90.0",
    "@vscode/vsce": "^3.6.2",
    "pngjs": "^7.0.0",
    "typescript": "^5.8.2"
  },
  "dependencies": {
    "mermaid": "^11.13.0"
  }
}
