{
  "name": "stateviz",
  "displayName": "StateViz",
  "description": "Visualize LangGraph StateGraph flows from Python files in a VS Code preview panel.",
  "version": "0.0.1",
  "publisher": "local",
  "license": "MIT",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Visualization",
    "Other"
  ],
  "activationEvents": [
    "onLanguage:python",
    "onCommand:stateviz.openPreview",
    "onCommand:stateviz.reveal"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "stateviz.openPreview",
        "title": "StateViz: Open Preview"
      },
      {
        "command": "stateviz.reveal",
        "title": "StateViz: Open Preview"
      },
      {
        "command": "stateviz.refresh",
        "title": "StateViz: Refresh Graph"
      }
    ],
    "configuration": {
      "title": "StateViz",
      "properties": {
        "stateviz.marker": {
          "type": "string",
          "default": "# stateviz: langgraph",
          "description": "Magic comment required before StateViz attempts to parse a Python file."
        }
      }
    }
  },
  "scripts": {
    "build": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "test": "node --test dist/test/**/*.test.js",
    "pretest": "npm run build"
  },
  "devDependencies": {
    "@types/node": "^22.14.1",
    "@types/vscode": "^1.90.0",
    "typescript": "^5.8.2"
  },
  "dependencies": {
    "mermaid": "^11.13.0"
  }
}
